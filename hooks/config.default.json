{
  "no_delete": {
    "enabled": true,
    "allow_paths": [
      "/tmp/*",
      "/private/tmp/*",
      "/private/var/folders/*",
      "/var/folders/*",
      "*/scratchpad/*",
      "*/build/*",
      "*/build_*/*",
      "*/_build/*",
      "*/node_modules/*",
      "*/.venv/*",
      "*/venv/*",
      "*/__pycache__/*",
      "*/.pytest_cache/*",
      "*/CMakeFiles/*",
      "*/DerivedData/*",
      "*.o",
      "~/.Trash/*"
    ],
    "block_git_clean": true
  },
  "no_mass_kill": {
    "enabled": true
  },
  "backup": {
    "enabled": true,
    "max_file_mb": 20,
    "rules": [
      {
        "roots": [
          "~/code",
          "~/projects"
        ],
        "globs": [
          "*.py",
          "*.js",
          "*.mjs",
          "*.ts",
          "*.tsx",
          "*.html",
          "*.css",
          "*.swift",
          "*.cpp",
          "*.h",
          "*.json",
          "*.md",
          "CMakeLists.txt"
        ],
        "exclude": [
          "*/build/*",
          "*/build_*/*",
          "*/dist/*",
          "*/node_modules/*",
          "*/.venv/*",
          "*/venv/*",
          "*/.git/*",
          "*/__pycache__/*"
        ]
      }
    ]
  },
  "stop_reminder": {
    "enabled": true,
    "message": "Before you say it's done: you changed files this turn but I see no test run. Use it like a user would (run the tests, or launch the thing and try it) and show the result. If you already did, say what you ran and what you saw."
  }
}
